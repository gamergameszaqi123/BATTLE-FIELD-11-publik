local PICKUP_CONFIG = {ScanRadius = 11, PickupInterval = 0.1, Enabled = false}
local function pickupLoop()
    task.spawn(function()
        while PICKUP_CONFIG.Enabled do
            local WorldItems = Workspace:FindFirstChild("WorldItems")
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if WorldItems and root then
                for _, item in pairs(WorldItems:GetChildren()) do
                    local part = item:IsA("BasePart") and item or (item:IsA("Model") and item.PrimaryPart)
                    if part and (part.Position - root.Position).Magnitude <= PICKUP_CONFIG.ScanRadius then
                        local pId = item:GetAttribute("PickupId")
                        if not pId then
                            for _, c in pairs(item:GetDescendants()) do
                                if c:IsA("StringValue") and c.Value:find("^pickup_") then pId = c.Value break end
                            end
                        end
                        if pId then
                            pcall(function() PickupEvent:FireServer({pickupId = pId}) end)
                            task.wait(PICKUP_CONFIG.PickupInterval)
                        end
                    end
                end
            end
            task.wait(0.2)
        end
    end)
end
