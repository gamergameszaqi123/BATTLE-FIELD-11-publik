local function scanLivestock()
    local result = {}
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return result end
    for _, plot in ipairs(plots:GetChildren()) do
        if plot.Name:match("^Plot_%d+$") then
            local placedItems = plot:FindFirstChild("PlacedItems")
            if placedItems then
                for _, deco in ipairs(placedItems:GetChildren()) do
                    if deco.Name:find("AnimalPen") or deco.Name:find("AnimalPlot") then
                        local ownerId = deco:GetAttribute("OwnerId")
                        local slotId = deco:GetAttribute("SlotId")
                        if tonumber(ownerId) == player.UserId and slotId then
                            local visuals = deco:FindFirstChild("LivestockVisuals")
                            if visuals then
                                for _, animal in ipairs(visuals:GetChildren()) do
                                    if animal:IsA("Model") then
                                        local uuid = animal:GetAttribute("AnimalUniqueId") or animal.Name:match("([%x%-]+)$")
                                        local itemId = animal:GetAttribute("ItemId") or animal.Name
                                        if uuid then
                                            table.insert(result, {SlotId = tostring(slotId), AnimalUniqueId = uuid, Name = animal.Name, ItemId = itemId:lower()})
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return result
end

