-- BAGIAN 5B: AUTO WATER (REFILL TIAP 20x SIRAM)
-- ==========================================

local WATER_CONFIG = {
    Enabled = false,
    WaterInterval = 0.1,     -- jeda antar siram
    RefillEvery = 20,        -- refill tiap 20x siram
    RefillDelay = 0.8,       -- jeda setelah refill
    ScanDelay = 0.3,         -- jeda antar scan
    IdleDelay = 1.0          -- jeda kalau tidak ada plot kering
}

-- Scan semua soil di FarmSoils_Plot yang belum disiram
local function scanDrySoils()
    local dry = {}
    for _, f in pairs(Workspace:GetChildren()) do
        if f.Name:find("FarmSoils_Plot") then
            for _, s in pairs(f:GetChildren()) do
                if s:IsA("Model") and s.Name:find("^soil_") then
                    -- Watered == false berarti kering / belum disiram
                    if s:GetAttribute("Watered") == false then
                        local id = s:GetAttribute("SoilId") or s.Name
                        table.insert(dry, id)
                    end
                end
            end
        end
    end
    return dry
end

local function waterLoop()
    task.spawn(function()
        while WATER_CONFIG.Enabled do
            -- 1) Cek jumlah plot kering
            local drySoils = scanDrySoils()

            if #drySoils == 0 then
                -- Tidak ada plot kering, tunggu lalu scan lagi
                task.wait(WATER_CONFIG.IdleDelay)
                continue
            end

            print(string.format("[Water] 💧 Ditemukan %d plot kering", #drySoils))

            -- 2) Refill dulu sebelum mulai menyiram
            pcall(function() RefillEvent:FireServer() end)
            task.wait(WATER_CONFIG.RefillDelay)

            -- 3) Siram satu per satu, refill tiap 20x
            local waterCount = 0
            for _, soilId in ipairs(drySoils) do
                if not WATER_CONFIG.Enabled then break end

                pcall(function() WaterEvent:FireServer({SoilId = soilId}) end)
                waterCount = waterCount + 1
                print(string.format("[Water] 💧 #%d | %s", waterCount, soilId))

                -- Setiap 20x siram → refill lagi
                if waterCount % WATER_CONFIG.RefillEvery == 0 then
                    print(string.format("[Water] 🚰 Refill setelah %d siram", waterCount))
                    pcall(function() RefillEvent:FireServer() end)
                    task.wait(WATER_CONFIG.RefillDelay)
                end

                task.wait(WATER_CONFIG.WaterInterval)
            end

            -- 4) Setelah semua tersiram, scan lagi untuk memastikan
            task.wait(WATER_CONFIG.ScanDelay)
        end
    end)
end

local WaterBtn = createToggleButton(
    "AuraWaterButton", 3, 199, 42, "💧",
    Color3.fromRGB(50, 150, 255), Color3.fromRGB(100, 200, 255),
    function()
        WATER_CONFIG.Enabled = not WATER_CONFIG.Enabled
        if WATER_CONFIG.Enabled then
            print("[Water] ✓ AKTIF")
            waterLoop()
        else
            print("[Water] ✗ NONAKTIF")
        end
    end
)
RunService.RenderStepped:Connect(function() updateToggleVisual(WaterBtn, WATER_CONFIG.Enabled) end)

