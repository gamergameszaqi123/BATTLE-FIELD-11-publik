local AURA_CONFIG = {ScanRadius = 30, AttackInterval = 0.05, Enabled = false}
local function attackLoop()
    task.spawn(function()
        while AURA_CONFIG.Enabled do
            local ids = {}
            local Active = Workspace:FindFirstChild("Mobs") and Workspace.Mobs:FindFirstChild("Active")
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if Active and root then
                for _, wrapper in pairs(Active:GetChildren()) do
                    if wrapper:IsA("Model") then
                        local hum = wrapper:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            local mRoot = wrapper:FindFirstChild("HumanoidRootPart")
                            if mRoot and (mRoot.Position - root.Position).Magnitude <= AURA_CONFIG.ScanRadius then
                                local id = wrapper:GetAttribute("EntityId")
                                if id then table.insert(ids, id) end
                            end
                        end
                    end
                end
            end
            if #ids > 0 then pcall(function() Event:FireServer(ids, ids) end) end
            task.wait(AURA_CONFIG.AttackInterval)
        end
    end)
end
