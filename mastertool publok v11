-- ⭐ SETUP SUARA BEEP
local beepSound = Instance.new("Sound")
beepSound.SoundId = "rbxassetid://9046863579"
beepSound.Volume = 0.5
beepSound.Parent = SoundService
local lastBeepTime = 0

local function playBeep()
    if tick() - lastBeepTime < 1.5 then return end
    lastBeepTime = tick()
    pcall(function()
        beepSound:Stop()
        beepSound:Play()
    end)
end

local function slideInNotif(playerName, distance)
    notifText.Text = string.format("%s — %d studs", playerName, math.floor(distance))
    TweenService:Create(notifFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 20, 0, 100)
    }):Play()
    
    task.delay(CHAMS_CONFIG.NotifDuration, function()
        TweenService:Create(notifFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, -280, 0, 100)
        }):Play()
        task.wait(0.4) 
        notifActive = false
        if #notifQueue > 0 then
            local n = table.remove(notifQueue, 1)
            notifActive = true 
            slideInNotif(n.name, n.dist)
        end
    end)
end

local function showNotif(n, d)
    if notifActive then 
        table.insert(notifQueue, {name=n, dist=d})
    else 
        notifActive = true 
        slideInNotif(n, d) 
    end
end

-- ⭐ SETUP CHAMS & LOOP
local function getChamsRoot(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

local function createChamsForPlayer(target)
    if target == player or chamsHolders[target] then return end
    local holder = Instance.new("Folder")
    holder.Name = "ProxChams_" .. target.Name
    holder.Parent = PlayerGui
    chamsHolders[target] = holder
    
    local function buildChams()
        for _, v in ipairs(holder:GetChildren()) do v:Destroy() end
        local char = target.Character
        if not char then return end
        
        -- Kotak Hijau Tembus Pandang
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local a = Instance.new("BoxHandleAdornment")
                a.Adornee = part a.AlwaysOnTop = true a.ZIndex = 5
                a.Size = part.Size a.Transparency = 0.4
                a.Color = BrickColor.new(Color3.fromRGB(0, 255, 100)) 
                a.Parent = holder
            end
        end
        
        -- Nama Player
        local head = char:FindFirstChild("Head")
        if head then
            local billboard = Instance.new("BillboardGui")
            billboard.Adornee = head billboard.Size = UDim2.new(0, 120, 0, 20)
            billboard.StudsOffset = Vector3.new(0, 2.5, 0) billboard.AlwaysOnTop = true 
            billboard.Parent = holder
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, 0, 1, 0) nameLabel.BackgroundTransparency = 1
            nameLabel.Text = target.Name nameLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            nameLabel.TextStrokeTransparency = 0 nameLabel.Font = Enum.Font.SourceSansBold
            nameLabel.TextSize = 14 nameLabel.Parent = billboard
        end
    end
    
    buildChams()
    local conn = target.CharacterAdded:Connect(function()
        task.wait(0.5) if CHAMS_CONFIG.Enabled then buildChams() end
    end)
    chamsConnections[target] = chamsConnections[target] or {}
    table.insert(chamsConnections[target], conn)
end

local function removeChamsForPlayer(target)
    if chamsHolders[target] then chamsHolders[target]:Destroy() chamsHolders[target] = nil end
    if chamsConnections[target] then
        for _, conn in ipairs(chamsConnections[target]) do pcall(function() conn:Disconnect() end) end
        chamsConnections[target] = nil
    end
end

local function startProximityLoop()
    task.spawn(function()
        while CHAMS_CONFIG.Enabled do
            local char = player.Character
            local myRoot = char and getChamsRoot(char)
            if myRoot then
                for _, target in ipairs(Players:GetPlayers()) do
                    if target ~= player then
                        local tc = target.Character
                        local tr = tc and getChamsRoot(tc)
                        if tr then
                            local dist = (tr.Position - myRoot.Position).Magnitude
                            if dist <= CHAMS_CONFIG.ProximityDistance then
                                if not alertedPlayers[target] then
                                    alertedPlayers[target] = true
                                    playBeep()              -- ⭐ Beep
                                    showNotif(target.Name, dist) -- ⭐ Notif
                                end
                            else
                                if alertedPlayers[target] then alertedPlayers[target] = nil end
                            end
                        end
                    end
                end
            end
            task.wait(0.3)
        end
    end)
end

local function toggleChams()
    CHAMS_CONFIG.Enabled = not CHAMS_CONFIG.Enabled
    if CHAMS_CONFIG.Enabled then
        for _, t in ipairs(Players:GetPlayers()) do
            if t ~= player then createChamsForPlayer(t) end
        end
        startProximityLoop()
    else
        for t, _ in pairs(chamsHolders) do removeChamsForPlayer(t) end
        chamsHolders = {} alertedPlayers = {} notifQueue = {}
    end
end

Players.PlayerAdded:Connect(function(t)
    if CHAMS_CONFIG.Enabled then task.wait(1) createChamsForPlayer(t) end
end)
Players.PlayerRemoving:Connect(function(t)
    removeChamsForPlayer(t) alertedPlayers[t] = nil
end)

